{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc:execution-event:5",
  "title": "Versioned bounded-execution accounting event, version 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "binding",
    "sequence",
    "occurredAt",
    "recordedAt",
    "actor",
    "type",
    "taskId",
    "attemptId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "eventId": {
      "$ref": "urn:sdlc:execution-plan:1#/$defs/id"
    },
    "binding": {
      "$ref": "urn:sdlc:execution-plan:1#/$defs/binding"
    },
    "sequence": {
      "$ref": "urn:sdlc:execution-plan:1#/$defs/positiveInteger"
    },
    "occurredAt": {
      "$ref": "urn:sdlc:execution-event:1#/properties/occurredAt"
    },
    "recordedAt": {
      "$ref": "urn:sdlc:execution-event:1#/properties/recordedAt"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "id"
      ],
      "properties": {
        "role": {
          "const": "manager"
        },
        "id": {
          "const": "local-orchestrator"
        }
      }
    },
    "type": {
      "enum": [
        "BATCH_ATTEMPT_ACCOUNTED",
        "BATCH_ATTEMPT_ACCOUNTING_UNKNOWN"
      ]
    },
    "taskId": {
      "$ref": "urn:sdlc:execution-plan:1#/$defs/id"
    },
    "attemptId": {
      "$ref": "urn:sdlc:execution-plan:1#/$defs/id"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchId",
        "batchDigest",
        "briefDigest",
        "modelCalls",
        "toolCalls",
        "elapsedMs",
        "inputBytes",
        "outputBytes",
        "totalInputBytes",
        "promptComponents",
        "retries",
        "modelId",
        "providerId",
        "hostId",
        "hostBuild",
        "providerInputTokens",
        "providerOutputTokens",
        "cachedInputTokens",
        "billableInputTokens",
        "billableOutputTokens",
        "authoritativeCost",
        "requestAccounting"
      ],
      "properties": {
        "batchId": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/id"
        },
        "batchDigest": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/digest"
        },
        "resultId": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/id"
        },
        "briefDigest": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/digest"
        },
        "modelCalls": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
        },
        "toolCalls": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
        },
        "elapsedMs": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
        },
        "inputBytes": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
        },
        "outputBytes": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
        },
        "totalInputBytes": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
        },
        "promptComponents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executionProtocol",
            "taskBrief",
            "selectedRole",
            "sharedContext",
            "specialistContext",
            "requirements",
            "securityConstraints",
            "permittedTools",
            "history"
          ],
          "properties": {
            "executionProtocol": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "taskBrief": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "selectedRole": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "sharedContext": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "specialistContext": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "requirements": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "securityConstraints": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "permittedTools": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "history": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            }
          }
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "modelId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostId": {
          "$ref": "urn:sdlc:execution-plan:1#/$defs/id"
        },
        "hostBuild": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "providerInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "providerOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "billableInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "billableOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "authoritativeCost": {
          "const": null
        },
        "requestAccounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prepared",
            "dispatched",
            "completed",
            "interrupted",
            "unknown"
          ],
          "properties": {
            "prepared": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "dispatched": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "completed": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "interrupted": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            },
            "unknown": {
              "$ref": "urn:sdlc:execution-plan:1#/$defs/nonnegativeInteger"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "BATCH_ATTEMPT_ACCOUNTED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "resultId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BATCH_ATTEMPT_ACCOUNTING_UNKNOWN"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "not": {
              "required": [
                "resultId"
              ]
            }
          }
        }
      }
    }
  ]
}
