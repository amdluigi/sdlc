{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc:execution-record:1",
  "title": "Atomic logically append-only manual execution record, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionId", "revisions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "executionId": {"$ref": "urn:sdlc:execution-plan:1#/$defs/id"},
    "revisions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["plan", "consent", "events", "receipts", "acceptances", "approvals"],
        "properties": {
          "plan": {"$ref": "urn:sdlc:execution-plan:1"},
          "consent": {"$ref": "urn:sdlc:execution-consent:1"},
          "events": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {"$ref": "urn:sdlc:execution-event:1"}
          },
          "receipts": {
            "type": "object", "maxProperties": 256,
            "propertyNames": {"$ref": "urn:sdlc:execution-plan:1#/$defs/id"},
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["brief", "result"],
              "properties": {
                "brief": {"$ref": "urn:sdlc:task-brief:1"},
                "result": {"$ref": "urn:sdlc:task-result:1"}
              }
            }
          },
          "acceptances": {
            "type": "object", "maxProperties": 256,
            "propertyNames": {"$ref": "urn:sdlc:execution-plan:1#/$defs/id"},
            "additionalProperties": {"$ref": "urn:sdlc:execution-acceptance:1"}
          },
          "approvals": {
            "type": "object", "maxProperties": 256,
            "propertyNames": {"$ref": "urn:sdlc:execution-plan:1#/$defs/id"},
            "additionalProperties": {
              "type": "object", "additionalProperties": false,
              "required": ["planDigest", "policyDigest"],
              "properties": {
                "planDigest": {"$ref": "urn:sdlc:execution-plan:1#/$defs/digest"},
                "policyDigest": {"$ref": "urn:sdlc:execution-plan:1#/$defs/digest"}
              }
            }
          }
        }
      }
    }
  }
}
