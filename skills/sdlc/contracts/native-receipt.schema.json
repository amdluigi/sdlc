{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc:native-receipt:1",
  "title": "Cooperatively observed native host receipt, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestDigest", "hostId", "hostBuild", "callId", "result"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestDigest": {"$ref": "urn:sdlc:execution-plan:1#/$defs/digest"},
    "hostId": {"$ref": "urn:sdlc:execution-plan:1#/$defs/id"},
    "hostBuild": {"type": "string", "minLength": 1, "maxLength": 128},
    "callId": {"type": "string", "minLength": 1, "maxLength": 256},
    "result": {"$ref": "urn:sdlc:task-result:1"}
  }
}
