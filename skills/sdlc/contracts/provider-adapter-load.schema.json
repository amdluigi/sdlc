{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc:provider-adapter-load:1",
  "title": "Trusted host-injected provider token load response",
  "description": "Snapshot result from the embedding host's trusted adapter after atomic opaque-token validation and consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostProfile", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "hostProfile": {
      "enum": ["copilot-vscode", "claude-code", "generic-agent-skills"]
    },
    "status": {
      "enum": [
        "loaded", "revoked", "token-unknown", "token-replayed", "unloadable"
      ]
    },
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "loaded"}}},
      "then": {"required": ["snapshot"]},
      "else": {"not": {"required": ["snapshot"]}}
    }
  ],
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredName", "providerMetadata", "contentDigest", "content"
      ],
      "properties": {
        "declaredName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "providerMetadata": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "required": [
            "sdlc-provider-schema", "sdlc-compatible", "sdlc-modules"
          ],
          "properties": {
            "sdlc-provider-schema": {"type": "string"},
            "sdlc-compatible": {"type": "string"},
            "sdlc-modules": {"type": "string"}
          }
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content": {"type": "string"}
      }
    }
  }
}
