{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc:provider-resolution:1",
  "title": "Resolved replacement providers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostProfile", "providers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "hostProfile": {
      "enum": ["copilot-vscode", "claude-code", "generic-agent-skills"]
    },
    "providers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "hostProfile", "providerMetadata", "contentDigest", "loadToken"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "hostProfile": {
          "enum": ["copilot-vscode", "claude-code", "generic-agent-skills"]
        },
        "providerMetadata": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "required": [
            "sdlc-provider-schema", "sdlc-compatible", "sdlc-modules"
          ],
          "properties": {
            "sdlc-provider-schema": {"type": "string"},
            "sdlc-compatible": {"type": "string"},
            "sdlc-modules": {"type": "string"}
          }
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "loadToken": {"type": "string", "minLength": 1}
      }
    }
  }
}
