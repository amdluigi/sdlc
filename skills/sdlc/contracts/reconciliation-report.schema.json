{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc:reconciliation-report:1",
  "title": "SDLC external requirements reconciliation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "prdId", "authority", "source", "normalized", "mappings", "assignedIds", "missing", "conflicts", "superseded", "overlay", "approval", "generated"],
  "properties": {
    "schemaVersion": {"const": 1},
    "prdId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "artifact", "generatedView"],
      "properties": {
        "mode": {"enum": ["direct", "generated-view"]},
        "artifact": {"$ref": "#/$defs/path"},
        "generatedView": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "priorDigest": ["priorVersion"],
        "priorVersion": ["priorDigest"]
      },
      "required": ["kind", "path", "digest", "revision", "files"],
      "properties": {
        "kind": {"enum": ["generic-spec", "feature-design", "issue-export", "structured-spec", "repository-prd"]},
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"},
        "revision": {"type": ["string", "null"]},
        "priorDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "priorVersion": {"type": ["integer", "null"], "minimum": 1},
        "files": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "digest"],
                "properties": {
                  "path": {"$ref": "#/$defs/path"},
                  "digest": {"$ref": "#/$defs/digest"}
                }
              }
            }
          ]
        }
      }
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status"],
      "properties": {
        "version": {"type": ["integer", "null"], "minimum": 1},
        "status": {"enum": ["draft", "approved", "superseded"]}
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "source", "transform", "confidence"],
        "properties": {
          "target": {"type": "string", "pattern": "^/"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector"],
            "properties": {"selector": {"type": "string", "minLength": 1}}
          },
          "transform": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["exact", "reviewed"]}
        }
      }
    },
    "assignedIds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKey", "targetId"],
        "properties": {
          "sourceKey": {"type": "string", "minLength": 1},
          "targetId": {"type": "string", "pattern": "^(?:FR|AC)-[1-9][0-9]*$"}
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "reason"],
        "properties": {
          "target": {"type": "string", "pattern": "^/"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "sources", "question", "owner", "blocking"],
        "properties": {
          "target": {"type": "string", "pattern": "^/"},
          "sources": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "question": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "superseded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "replacedBy", "reason", "approvalEvidence"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "replacedBy": {"type": "string", "pattern": "^(?:FR|AC)-[1-9][0-9]*$"},
          "reason": {"type": "string", "minLength": 1},
          "approvalEvidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "approvalEvidence"],
      "properties": {
        "sections": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "approvalEvidence": {"type": ["string", "null"]}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approver", "evidence", "approvedVersion", "approvedSourceDigest", "carryForward"],
      "properties": {
        "status": {"enum": ["draft", "approved"]},
        "approver": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]},
        "approvedVersion": {"type": ["integer", "null"], "minimum": 1},
        "approvedSourceDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "carryForward": {"type": ["string", "null"]}
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolVersion", "viewDigest"],
      "properties": {
        "toolVersion": {"enum": ["3.5.0", "3.5.1", "3.5.2", "3.5.3"]},
        "viewDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
